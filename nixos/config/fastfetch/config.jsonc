{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "/home/neo/neoconf/nixos/assets/icon/nixos.png",
    "width": 26,
    "height": 13,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " 󰅂 ",
    "color": {
      "separator": "bright_black"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;103;143;228m╭─   System ─────────────────────────────────────────────\u001b[0m"
    },
    {
      "type": "os",
      "key": "│   OS         ",
      "keyColor": "bright_blue"
    },
    {
      "type": "kernel",  
      "key": "│ 󰌢  kernel     ",
      "keyColor": "bright_blue"
    },
    {
      "type": "uptime",
      "key": "│ 󱫐  Uptime     ",
      "keyColor": "bright_blue"
    },
    {
      "type": "command",
      "key": "│ 󰔠  OS Age     ",
      "keyColor": "bright_blue",
      "text" : "echo $(( ($(date +%s) - $(stat -c %Y /etc/machine-id)) / 86400 )) Days" 


    },
    {
      "type": "custom",
      "format": "\u001b[38;2;103;143;228m╰──────────────────────────────────────────────────────────\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;171;102;204m╭─ 󱂬  Desktop ─────────────────────────────────────────────\u001b[0m"
    },
    {
      "type": "wm",
      "key": "│ 󰧨  Compositor ",
      "keyColor": "bright_magenta"
    },
    {
      "type": "terminal",
      "key": "│   Теrminal   ",
      "keyColor": "bright_magenta"
    },
    {
      "type": "shell",
      "key": "│ 󰞷  Shell      ",
      "keyColor": "bright_magenta"
    },
    {
      "type": "display",
      "key": "│ 󰍹  Мonitor    ",
      "keyColor": "bright_magenta"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;171;102;204m╰──────────────────────────────────────────────────────────\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;121;185;181m╭─   Hardware ────────────────────────────────────────────\u001b[0m"
    },
    {
      "type": "cpu",
      "key": "│   CPU         ",
      "keyColor": "bright_cyan"
    },
    {
      "type": "gpu",
      "key": "│ 󰢮  GPU         ",
      "keyColor": "bright_cyan",
      "format": "{1} {2}"
    },
    {
      "type": "memory",
      "key": "│ 󰘚  Memory      ",
      "keyColor": "bright_cyan"
    },
    {
      "type": "disk",
      "key": "│ 󰋊  Disk (Root) ",
      "folders": "/",
      "keyColor": "bright_cyan"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;121;185;181m╰───────────────────────────────────────────────────────────\u001b[0m"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    }
  ]
}
